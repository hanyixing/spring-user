# ============================================================
# 后端环境变量示例
# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略，请勿提交真实密钥）
# 通过启动命令注入，例如：
#   SPRING_PROFILES_ACTIVE=prod \
#   ENCRYPTION_AES_KEY=xxxxxx \
#   DEFAULT_ADMIN_PASSWORD=xxxxxx \
#   SQLITE_DB_PATH=/var/lib/spring-user/data/user.db \
#   java -jar target/spring-user-1.0.0.jar
# ============================================================

# 激活的环境：dev / test / prod
SPRING_PROFILES_ACTIVE=dev

# 服务端口
SERVER_PORT=10010

# SQLite 数据库路径（按环境区分）
# dev 默认 ./data/user.db，test 默认 ./data/test.db，prod 必须显式指定独立路径
SQLITE_DB_PATH=./data/user.db

# AES 加密密钥（Base64）。生产环境必须设置为自有密钥，切勿使用此示例值
ENCRYPTION_AES_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
ENCRYPTION_KEY_TYPE=FIXED

# 默认管理员账户。生产环境 DEFAULT_ADMIN_PASSWORD 必须设置为强密码
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_ROLE=SUPER_ADMIN

# 是否加载测试数据（生产环境应为 false）
TEST_DATA_ENABLED=true

# 生产环境 Hikari 连接池（可选，留空则使用默认值）
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_POOL_CONN_TIMEOUT=30000
# DB_POOL_IDLE_TIMEOUT=600000
# DB_POOL_MAX_LIFETIME=1800000
